# Windows bootstrap + smoke (VS Clang + nmake).
# From a Developer Command Prompt / PowerShell with clang and nmake on PATH:
#
#   nmake /f Makefile.msvc
#   nmake /f Makefile.msvc check
#   nmake /f Makefile.msvc clean
#
# Unix / macOS: use the GNU Makefile as usual.
# Not a port of the full Unix `check` corpus.
#
# OBJS basenames must match Makefile SRCS (src/*.c). When you add a .c there,
# add $(BUILD)\name.o here — the compile rule is shared below.

CC = clang
QBE = qbe.exe
QBEFLAGS = -t amd64_win

# Forward-slash paths for -D string macros (escape-friendly).
ROOT = .
HOST = src/host/include
BUILD = build
MODC = modc.exe

CFLAGS = -O2 -Wall -Wno-unused-parameter -D_CRT_SECURE_NO_WARNINGS \
	-DMODC_INCLUDE=\"$(HOST)\" -DMODC_PKG=\"$(ROOT)\"

OBJS = \
	$(BUILD)\main.o \
	$(BUILD)\cli_build.o \
	$(BUILD)\cli_cmd.o \
	$(BUILD)\cli_selftest.o \
	$(BUILD)\diag.o \
	$(BUILD)\lex.o \
	$(BUILD)\pp.o \
	$(BUILD)\parse.o \
	$(BUILD)\type.o \
	$(BUILD)\format.o \
	$(BUILD)\symbol.o \
	$(BUILD)\check.o \
	$(BUILD)\emit.o \
	$(BUILD)\pkg.o \
	$(BUILD)\fmt.o \
	$(BUILD)\vendor.o \
	$(BUILD)\host_os.o \
	$(BUILD)\cache.o \
	$(BUILD)\export.o

HDRS = src\ast.h src\cli.h src\host_os.h

all: $(MODC)

$(MODC): $(OBJS)
	$(CC) -o $(MODC) $(OBJS)
	@echo Built $(MODC)

# One recipe for every src\<name>.c → build\<name>.o (nmake inference).
{src\}.c{$(BUILD)\}.o:
	if not exist $(BUILD) mkdir $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJS): $(HDRS)

check: $(MODC)
	@echo == attr_hdr check ==
	.\$(MODC) check test\attr_hdr.mc
	@echo == bad_attr (expect fail) ==
	-.\$(MODC) check test\bad_attr.mc > $(BUILD)\bad_attr.out 2>&1
	findstr /C:"for headers only" $(BUILD)\bad_attr.out >nul
	@echo == win header interop smokes ==
	.\$(MODC) check test\win_hdr_soup.mc
	.\$(MODC) check test\win_ptr64.mc
	.\$(MODC) check test\win_vcruntime.mc
	.\$(MODC) check test\win_corecrt.mc
	.\$(MODC) check test\win_fn_typedef.mc
	.\$(MODC) check test\win_pragma_enum.mc
	.\$(MODC) check test\win_declspec_tag.mc
	@echo == windows.h ==
	.\$(MODC) check test\windows_h.mc
	@echo == system includes (-v) ==
	.\$(MODC) check -v test\win_vcruntime.mc 2> $(BUILD)\sysinc.out
	-findstr /C:"system include:" $(BUILD)\sysinc.out >nul
	@echo == win_abi interop ==
	.\$(MODC) emit test\win_abi_modc.mc > $(BUILD)\win_abi_modc.qbe
	$(QBE) $(QBEFLAGS) -o $(BUILD)\win_abi_modc.s $(BUILD)\win_abi_modc.qbe
	$(CC) -c -o $(BUILD)\win_abi_host.o test\win_abi_host.c
	$(CC) -c -o $(BUILD)\win_abi_modc.o $(BUILD)\win_abi_modc.s
	$(CC) -o $(BUILD)\win_abi-test.exe test\win_abi_main.c $(BUILD)\win_abi_modc.o $(BUILD)\win_abi_host.o
	$(BUILD)\win_abi-test.exe
	@echo == fp_byvalue interop ==
	.\$(MODC) emit test\fp_byvalue_modc.mc > $(BUILD)\fp_byvalue_modc.qbe
	$(QBE) $(QBEFLAGS) -o $(BUILD)\fp_byvalue_modc.s $(BUILD)\fp_byvalue_modc.qbe
	$(CC) -c -o $(BUILD)\fp_byvalue_host.o test\fp_byvalue_host.c
	$(CC) -c -o $(BUILD)\fp_byvalue_modc.o $(BUILD)\fp_byvalue_modc.s
	$(CC) -o $(BUILD)\fp_byvalue-test.exe test\fp_byvalue_main.c $(BUILD)\fp_byvalue_modc.o $(BUILD)\fp_byvalue_host.o
	$(BUILD)\fp_byvalue-test.exe
	@echo All Windows smokes passed.

clean:
	if exist $(BUILD)\*.o del /q $(BUILD)\*.o
	if exist $(BUILD)\*.obj del /q $(BUILD)\*.obj
	if exist $(BUILD)\*.s del /q $(BUILD)\*.s
	if exist $(BUILD)\*.qbe del /q $(BUILD)\*.qbe
	if exist $(BUILD)\*-test.exe del /q $(BUILD)\*-test.exe
	if exist $(BUILD)\*.out del /q $(BUILD)\*.out
	if exist $(MODC) del /q $(MODC)
	if exist *.pdb del /q *.pdb
	@echo cleaned
